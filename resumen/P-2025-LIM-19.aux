\@writefile{toc}{\contentsline {section}{\numberline {1}Introducción}{1}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Interfaz de la aplicación desarrollada en Google Earth Engine, se muestra la capa de cobertura agrícola (verde) y a la izquierda el panel con las opciones de análisis y gráficos de monitoreo.}}{2}{figure.caption.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Materiales y Métodos}{2}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Clasificación de la cobertura agrícola}{3}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Máscara de cobertura agrícola realizada de manera manual mediante software QGIS a partir de imágenes satelitales Sentinel-2/L2A, se muestra la zona de Lambayeque-Perú con áreas etiquetadas como cultivos agrícolas y no agrícolas.}}{3}{figure.caption.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Matriz de confusión del modelo RF. División entrenamiento/validación realizada a nivel de polígono; evaluación calculada sobre n=11 205 píxeles de validación, provenientes de los polígonos no usados en entrenamiento. Se observa que el modelo clasifica correctamente 3216 píxeles de cobertura agrícola y 7352 píxeles de no agrícola, mientras que comete 518 falsos negativos y 119 falsos positivos.}}{3}{table.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:matriz-confusion}{{2}{3}{Matriz de confusión del modelo RF. División entrenamiento/validación realizada a nivel de polígono; evaluación calculada sobre n=11 205 píxeles de validación, provenientes de los polígonos no usados en entrenamiento. Se observa que el modelo clasifica correctamente 3216 píxeles de cobertura agrícola y 7352 píxeles de no agrícola, mientras que comete 518 falsos negativos y 119 falsos positivos}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Métricas de desempeño del modelo RF por clase, calculadas a partir de la matriz de confusión. La precisión de usuario indica la confiabilidad de las predicciones positivas, mientras que la precisión de producto indica la proporción de píxeles reales correctamente clasificados. El F1-Score es la media armónica entre ambas métricas.}}{3}{table.caption.5}\protected@file@percent }
\newlabel{tab:metricas-desempeño}{{3}{3}{Métricas de desempeño del modelo RF por clase, calculadas a partir de la matriz de confusión. La precisión de usuario indica la confiabilidad de las predicciones positivas, mientras que la precisión de producto indica la proporción de píxeles reales correctamente clasificados. El F1-Score es la media armónica entre ambas métricas}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Errores de omisión y comisión por clase del modelo RF, explican la proporción de falsos negativos y falsos positivos respectivamente, complementando la información de la matriz de confusión.}}{4}{table.caption.6}\protected@file@percent }
\newlabel{tab:errores-omision-comision}{{4}{4}{Errores de omisión y comisión por clase del modelo RF, explican la proporción de falsos negativos y falsos positivos respectivamente, complementando la información de la matriz de confusión}{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Aplicación del modelo a otras zonas geográficas}{4}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Máscara de cobertura agrícola del distrito de Chincha Baja (Ica), obtenida al aplicar, sin reentrenamiento, el modelo entrenado con etiquetas agrícolas de Lambayeque, Perú, obtenidas a través de imágenes satelitales (Sentinel-2/L2A), sobre vectores de Satellite Embedding V1/ANUAL (AlphaEarth Foundations). Resultado ilustrativo de la capacidad de generalización del modelo a otros valles costeros.}}{4}{figure.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Registro del monitoreo de la relación entre anomalías de TSM y dinámica agrícola}{4}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Visualización comparativa para el mes de febrero en el distrito de Chincha Baja (Ica). Se muestran los valores de NDVI y las anomalías de la TSM correspondientes a los meses de febrero del período 2009–2024. La figura tiene fines de comparación visual y no representa una medida de correlación estadística.}}{4}{figure.caption.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Automatización de la ingesta periódica de datos externos}{5}{subsection.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Comparación visual entre las series temporales de anomalías de TSM provenientes de NOAA e ICEN. Aunque ambas presentan diferencias en magnitud debido a sus metodologías de generación, se aprecia una tendencia temporal similar. Esta comparación tiene carácter ilustrativo y constituye una verificación visual del funcionamiento del flujo de ingesta, sin representar una validación estadística de la equivalencia entre ambas series. muestra el registro de las medias de anomalías de TSM (NOAA) de color rojo y las anomalías de TSM (ICEN) de color azul. Las ubicaciones espaciales de toma de datos em ambos datasets puede ser diferente pero su tendencia guarda similitud.}}{5}{figure.caption.9}\protected@file@percent }
